# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FACEBOOK_PAGE_ACCESS_TOKEN: Optional Meta Graph API Page Access Token for
# syncing God's Palace Evangelical Ministry Worldwide (100080364799775) videos.
# Not required: zero-secret public listening works automatically.
FACEBOOK_PAGE_ACCESS_TOKEN=""

# FACEBOOK_WEBHOOK_VERIFY_TOKEN: Optional secret token for verifying instant
# Meta Page webhooks at /api/webhooks/facebook. Leave empty if unused.
FACEBOOK_WEBHOOK_VERIFY_TOKEN=""
